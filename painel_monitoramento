#!/bin/bash

clear

verificar_servicos(){

    sites=("www.google.com.br" "www.escolaws.com.br" "painel.oracle.com" "clubedosprogramadores.com.br")

    let contador=0
    let linha_inicio=9

    for site in "${sites[@]}"; do
        info="$(ping -c 1 -W 5 "${site}" 2>&1)"

        if [[ "$info" =~ 0%[[:space:]]*(packet loss|de perda) ]]; then
            tput cup $(($linha_inicio + $contador)) 5; echo -e "\e[1;10m${site}\e[0m"
            tput cup $(($linha_inicio + $contador)) 46; echo -e "\e[1;32m[ OK ]\e[0m"
        else
            tput cup $(($linha_inicio + $contador)) 5; echo -e "\e[1;10m${site}\e[0m"
            tput cup $(($linha_inicio + $contador)) 46; echo -e "\e[1;5;31m[ FAIL ]\e[0m"
        fi

        contador=$(($contador + 1))
    done

}

desenha_painel(){

# Exemplo: 50 caracteres '#'
tput cup 5 5; printf '#%.0s' {1..50}
tput cup 6 5; printf "%-50s" "PAINEL DE MONITORAMENTO DE SERVIÇOS NO SEVIDOR"
tput cup 7 5; printf '#%.0s' {1..50}
tput cup 8 5; printf "%-30s\t%12s" "HOST" "STATUS" 

verificar_servicos

tput cup 13 5; printf '#%.0s' {1..50}
tput cup 14 5; printf "Status geral:"
tput cup 15 5; printf '#%.0s' {1..50}

}

