#!/bin/bash
#
# Shell Script com parâmetros
#

#$0, $1, $2, $3,...,$n

if [ -z "$1" ]; then

  echo "Você deve fornecer um parâmetro"
  exit 1;

fi

nome="$1"

if [[ "$1" == "--help"  ||  "$1" == "--help" ]]; then
    
    echo -e "\e[1;10;33m"
    echo "Como usar este comando:"
    echo "Você deve fornecer um dos parâmetros abaixo:"
    echo "--help|data|Data|hora|Hora"
    echo "--help: mostra essa ajuda"
    echo "data ou Data: Exibe a data atual do sistema"
    echo "hora ou Hora: Exibe a hora atual do sistema"
    echo -e "\e[0m"

elif [[ "$1" == "data" || "$1" == "Data" ]]; then
    echo "A data de hoje é:  $( date '+%d-%m-%Y' )"
elif [[ "$1" == "Hora"  ||  "$1" == "hora" ]]; then
    echo "A hora atual é: $( date '+%H:%M:%S')"
else 
    echo "Recurso não implementado"
fi




